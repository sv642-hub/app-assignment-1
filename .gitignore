# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Real environment files with secrets — never commit these.
# The *.example templates ARE committed.
.env
.env.*
!.env.example
!.env.production.example

# Test / coverage / type-check artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rendered docs previews (Quarto / RStudio)
README.html
README_files/
/*_files/
*.quarto_ipynb
.quarto/
