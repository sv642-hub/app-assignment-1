# Starts the two vLLM servers (compose.gpu.yml) when the GPU host boots,
# including after an unshelve. Install it with the steps in the README,
# "Start at boot"; they replace CHECKOUT_DIR with the checkout's path.
#
# Docker restarts containers at boot by itself, but all at once and without
# depends_on, so both servers claim GPU memory together and one can fail the
# memory check. This unit stops them at shutdown and starts them in order at
# boot: vllm-small, then vllm-large once vllm-small is healthy.
[Unit]
Description=Smart AI Gateway vLLM servers (compose.gpu.yml)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# 3 tries in all. The preflight already waits up to 5 minutes for the IP,
# the volume and the GPU, and `up` gives up after 20 minutes, so one try takes
# at most about 26 minutes. The interval is longer than 3 tries, so a slow
# failure still counts towards the limit and the unit stops after the third:
# `systemctl reset-failed` clears it.
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=CHECKOUT_DIR
ExecStartPre=CHECKOUT_DIR/deploy/autostart/gpu-preflight.sh
ExecStartPre=/usr/bin/docker compose -f compose.gpu.yml --env-file env/gpu.env -p smart-gateway-gpu down
ExecStart=/usr/bin/docker compose -f compose.gpu.yml --env-file env/gpu.env -p smart-gateway-gpu up -d --wait --wait-timeout 1200 --no-build --pull never
ExecStop=/usr/bin/docker compose -f compose.gpu.yml --env-file env/gpu.env -p smart-gateway-gpu down
# Loading both models from the cache takes about 3 minutes; this covers the
# preflight's wait and `up`'s own 20-minute limit.
TimeoutStartSec=30min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
