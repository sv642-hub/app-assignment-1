# Starts the gateway stack (compose.yml) when the CPU instance boots,
# including after an unshelve. Install it with the steps in the README,
# "Start at boot"; they replace CHECKOUT_DIR with the checkout's path and
# PROJECT_NAME with the Compose project the stack already runs as (the NAME
# column of `docker compose ls`), so `down` acts on that stack.
#
# Starting through Compose keeps depends_on (Postgres healthy before the
# gateway) and --wait reports a stack that never gets healthy as a failure.
# It never builds or pulls: it starts the images from the last deploy, and
# fails if one is missing.
[Unit]
Description=Smart AI Gateway stack (compose.yml)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# 3 tries in all, 30 seconds apart; one try takes at most about 6 minutes,
# so the interval covers all three and the unit then stops. `systemctl
# reset-failed` clears it.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=CHECKOUT_DIR
ExecStartPre=/usr/bin/docker compose -p PROJECT_NAME down
ExecStart=/usr/bin/docker compose -p PROJECT_NAME up -d --wait --wait-timeout 300 --no-build --pull never
ExecStop=/usr/bin/docker compose -p PROJECT_NAME down
TimeoutStartSec=10min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
