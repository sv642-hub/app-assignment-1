# Local-dev configuration shape.
# Copy to `.env` (which is git-ignored) and adjust as needed:
#   cp env/.env.example .env
#
# All variables are prefixed APP_ and map to Settings in
# src/smart_gateway/config.py. A typo'd key in a .env file is rejected at
# startup (extra="forbid"), so the set of knobs stays exactly this list.

APP_ENVIRONMENT=local
APP_DEBUG=true

APP_HOST=127.0.0.1
APP_PORT=8000

APP_LOG_LEVEL=DEBUG

# Optional locally; REQUIRED when APP_ENVIRONMENT=production.
# Never commit a real key — this placeholder is fine to share.
APP_API_KEY=

# Config files that stand in for Jev and the models. Relative paths resolve
# against the working directory (repo root locally, /app in Docker).
APP_INTENTS_PATH=config/intents.json
APP_POLICY_CARDS_PATH=config/policy_cards.json
APP_BACKENDS_PATH=config/backends.json
# How many recent requests GET /v1/requests/{id} can look up
APP_REQUEST_STORE_SIZE=1000
