# Optional overrides. Copy to env/.env without replacing an existing file.
APP_ENVIRONMENT=local
APP_INTENTS_PATH=config/intents.json
APP_LABELS_PATH=config/labels.json
APP_POLICY_CARDS_PATH=config/policy_cards.json
APP_BACKENDS_PATH=config/backends.json
APP_REQUEST_STORE_LIMIT=1000
APP_JEV_TIMEOUT_SECONDS=2
APP_RULE_ROUTER_COMPLEX_MIN_WORDS=20
APP_MONITOR_WINDOW=20
APP_MONITOR_MIN_SAMPLES=5
APP_MONITOR_FAILURE_THRESHOLD=0.5
APP_CONTROLLER_COOLDOWN_SECONDS=60

# Real providers. Mock stays the default; real mode is not built yet.
APP_PROVIDER_MODE=mock
APP_JEV_BASE_URL=https://api.typesafe.ai
APP_JEV_MODEL=jev-1.14.0
# Server-side secret. Set it only in the real env file, never in Git.
# APP_JEV_API_KEY=
# USD per million input tokens; Jev does not charge for output tokens.
# Leave unset until confirmed; cost stays null.
# APP_JEV_INPUT_PRICE_PER_MILLION_USD=
APP_JEV_BREAKER_FAILURES=5
APP_JEV_BREAKER_COOLDOWN_SECONDS=30
APP_REQUEST_DEADLINE_SECONDS=45
APP_ALTERNATE_RESERVE_SECONDS=15
