# Throwaway values so `docker compose up` and the CI smoke test work without
# any private env file. NOT FOR DEPLOYMENT: the password below is public.
#
# To deploy, set your own password in two private files (both ignored by Git):
#   env/postgres.env  POSTGRES_PASSWORD=...          (from env/postgres.env.example)
#   env/.env          APP_DATABASE_URL=postgresql://gateway:...@postgres:5432/gateway
# Postgres only reads the password when the volume is first created; see README.
#
# Compose reads this file as container environment, not as Pydantic dotenv, so
# the POSTGRES_* keys here do not reach the gateway's settings validation.
APP_STORE=postgres
APP_DATABASE_URL=postgresql://gateway:smoke-test-only-not-for-deployment@postgres:5432/gateway
POSTGRES_USER=gateway
POSTGRES_DB=gateway
POSTGRES_PASSWORD=smoke-test-only-not-for-deployment
