# Optional overrides. Copy to env/.env without replacing an existing file.
APP_ENVIRONMENT=production
APP_INTENTS_PATH=config/intents.json
APP_LABELS_PATH=config/labels.json
APP_POLICY_CARDS_PATH=config/policy_cards.json
APP_BACKENDS_PATH=config/backends.json
APP_REQUEST_STORE_LIMIT=1000
APP_JEV_TIMEOUT_SECONDS=2
APP_RULE_ROUTER_COMPLEX_MIN_WORDS=20
APP_MONITOR_WINDOW=20
APP_MONITOR_MIN_SAMPLES=5
APP_MONITOR_FAILURE_THRESHOLD=0.5
APP_CONTROLLER_COOLDOWN_SECONDS=60
# Semantic monitor: agreement with Jev's intent answer. Placeholders until
# they are set from dev data. With no baseline, rates are reported but never
# flagged; set it to the healthy disagreement rate measured on dev data.
APP_SEMANTIC_WINDOW=50
APP_SEMANTIC_MIN_SAMPLES=10
APP_SEMANTIC_MIN_COVERAGE=0.5
# APP_SEMANTIC_BASELINE_DISAGREEMENT_RATE=0.05
APP_SEMANTIC_ALERT_MARGIN=0.15
# Off: the semantic monitor only reports. Keep it off until the baseline is set
# from dev data.
APP_SEMANTIC_ACTIONS_ENABLED=false
# Storage: memory (default for native runs; lost on restart) or postgres.
# Compose already sets postgres with a throwaway password from
# env/compose.defaults.env. To deploy, uncomment, put your own password here
# and the same one in env/postgres.env.
# APP_STORE=postgres
# APP_DATABASE_URL=postgresql://gateway:YOUR_PASSWORD@postgres:5432/gateway
APP_STORE_TIMEOUT_SECONDS=2
# Postgres keeps every request for analysis; set a number to keep only the newest.
# APP_POSTGRES_REQUEST_LIMIT=100000

# Real providers. Mock stays the default.
# APP_JEV_MODE=real sends every chat message to TypeSafe, an outside service,
# and needs APP_JEV_API_KEY. APP_PROVIDER_MODE=real calls the two vLLM servers
# and needs the three APP_VLLM_ settings below.
APP_JEV_MODE=mock
APP_PROVIDER_MODE=mock
APP_JEV_BASE_URL=https://api.typesafe.ai
APP_JEV_MODEL=jev-1.14.0
# Server-side secret. Set it only in the real env file, never in Git.
# APP_JEV_API_KEY=
# USD per million input tokens; Jev does not charge for output tokens.
# Leave unset until confirmed; cost stays null.
# APP_JEV_INPUT_PRICE_PER_MILLION_USD=
APP_JEV_BREAKER_FAILURES=5
APP_JEV_BREAKER_COOLDOWN_SECONDS=30
# Operator routes (/v1/operator, /v1/faults). Unset turns them off. Use a long
# random value, at least 16 characters, only in the real env file.
# APP_OPERATOR_TOKEN=
# vLLM servers on the GPU host's private IP (compose.gpu.yml). Set when the
# Qwen backends are wired into the gateway; unused until then.
# APP_VLLM_SMALL_BASE_URL=http://GPU_PRIVATE_IP:8001
# APP_VLLM_LARGE_BASE_URL=http://GPU_PRIVATE_IP:8002
# Same value as VLLM_API_KEY in env/gpu.env on the GPU host. Never in Git.
# APP_VLLM_API_KEY=
APP_REQUEST_DEADLINE_SECONDS=45
APP_ALTERNATE_RESERVE_SECONDS=15
