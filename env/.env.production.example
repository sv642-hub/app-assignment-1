# Deployed (production) configuration shape.
# This is a TEMPLATE — real values are injected by the deployment platform's
# secret manager, NOT committed here. Never put a real secret in this file.
#
# Differences from local dev:
#   - APP_ENVIRONMENT=production (enables strict validators)
#   - APP_DEBUG must be false
#   - APP_HOST binds to all interfaces inside the container
#   - APP_API_KEY is REQUIRED (startup fails fast if missing)

APP_ENVIRONMENT=production
APP_DEBUG=false

APP_HOST=0.0.0.0
APP_PORT=8000

APP_LOG_LEVEL=INFO

# REQUIRED in production. Provide via the platform's secret store at deploy time.
APP_API_KEY=replace-me-with-a-secret-from-your-secret-manager
