# Settings for deploy/deploy.sh, backup.sh and restore.sh. Copy to
# env/deploy.env (ignored by Git). No secrets belong here.
#
# The public DNS name Caddy gets a certificate for. Required for HTTPS.
SITE_ADDRESS=gateway.example.org
# Where the release images live. Matches the release workflow.
IMAGE_REPO=ghcr.io/sv642-hub/app-assignment-1
# Compose project name; the one `docker compose ls` shows for the running stack.
COMPOSE_PROJECT_NAME=app-assignment-1
# One line per deploy, rollback and backup. Outside the checkout, so it
# survives a re-clone.
DEPLOY_LOG=~/deploy.log
# Local backups: where they go and how many to keep.
BACKUP_DIR=~/backups
BACKUP_KEEP=14
# Off-instance copy of every backup, made with scp. user@host:directory. Leave
# it empty to skip the copy; the backup script then says so.
BACKUP_REMOTE=
# Extra scp options, for example -i ~/.ssh/backup_ed25519.
BACKUP_SCP_OPTS=
